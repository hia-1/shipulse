/* ============================================================
   全局样式 · 简约设计系统
   画布 canvas #F6F7F6 / 卡片 surface #FFFFFF / 墨色 ink #1B1F1D
   次级 secondary #5A625E / 辅助 muted #8A918D / 极淡 faint #B9BFBB
   主色 accent #2C4A42 / 主色浅底 accent-tint #E7EEEA
   发丝线 hairline #EFF1EF / 柔和填充 soft #F2F3F2
   原则：去边框、去投影、去渐变，用留白与字重区分层级
   ============================================================ */
page {
  background: #f6f7f6;
  color: #1b1f1d;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 56rpx;
  box-sizing: border-box;
}

/* ---------- 文本 ---------- */
.serif {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
}
.title-lg {
  font-size: 44rpx;
  font-weight: 600;
  color: #1b1f1d;
  letter-spacing: 0;
  line-height: 1.3;
}
.title-md {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1f1d;
}
.title-sm {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b1f1d;
}
.text-secondary {
  color: #5a625e;
}
.text-muted {
  color: #8a918d;
}
.text-faint {
  color: #b9bfbb;
}
.text-pine {
  color: #2c4a42;
}
.text-gold {
  color: #a8894a;
}
.text-sm {
  font-size: 24rpx;
}
.text-xs {
  font-size: 22rpx;
}
.tabular {
  font-variant-numeric: tabular-nums;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.card-tight {
  padding: 8rpx 24rpx;
}

/* ---------- 布局 ---------- */
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.divider {
  height: 1rpx;
  background: #eff1ef;
  margin: 20rpx 0;
}

/* ---------- 搜索框 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  height: 80rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1b1f1d;
}
.search-placeholder {
  color: #8a918d;
}
.search-icon {
  color: #8a918d;
  margin-right: 12rpx;
  font-size: 28rpx;
}

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 32rpx;
  height: 88rpx;
  line-height: 1;
  border: none;
  box-sizing: border-box;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: #2c4a42;
  color: #ffffff;
}
.btn-ghost {
  background: #f2f3f2;
  color: #2c4a42;
  border: none;
}
.btn.btn-block {
  display: flex;
  width: 100%;
  margin-left: 0;
  margin-right: 0;
  padding-left: 0;
  padding-right: 0;
}
.btn-sm {
  height: 64rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
  border-radius: 10rpx;
}
.btn[disabled] {
  opacity: 0.45;
}

/* ---------- 筛选 chip ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5a625e;
  background: #f2f3f2;
  border: none;
  margin-right: 12rpx;
}
.chip-active {
  color: #2c4a42;
  background: #e7eeea;
  font-weight: 500;
}

/* ---------- 进度条 ---------- */
.progress {
  height: 6rpx;
  background: #eceeed;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-inner {
  height: 100%;
  background: #2c4a42;
  border-radius: 999rpx;
}

/* ---------- 书籍条目 ---------- */
.book-item {
  display: flex;
  padding: 20rpx 0;
}
.book-cover {
  width: 104rpx;
  height: 140rpx;
  border-radius: 6rpx;
  background: #f0f1f0;
  flex-shrink: 0;
}
.book-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.book-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1b1f1d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-sub {
  font-size: 24rpx;
  color: #8a918d;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #f2f3f2;
  color: #5a625e;
}
.tag-pine {
  background: #e7eeea;
  color: #2c4a42;
}

/* ---------- 空态 ---------- */
.empty {
  text-align: center;
  color: #b9bfbb;
  font-size: 26rpx;
  padding: 72rpx 0;
}
.empty-action {
  display: inline-block;
  margin-top: 16rpx;
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  background: #e7eeea;
  color: #2c4a42;
  font-size: 24rpx;
}

/* ---------- 封面兜底 ---------- */
.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  box-sizing: border-box;
  background: #eef0ef;
  color: #8a918d;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  overflow: hidden;
}

/* ---------- 书评 ---------- */
.review-item {
  padding: 24rpx 0;
}
.review-item + .review-item {
  border-top: 1rpx solid #eff1ef;
}
.review-head {
  display: flex;
  align-items: center;
}
.review-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f0f1f0;
}
.review-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e7eeea;
  color: #2c4a42;
  font-size: 20rpx;
  white-space: nowrap;
  overflow: hidden;
}
.review-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b1f1d;
  margin-top: 16rpx;
}
.review-content {
  margin-top: 8rpx;
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.review-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.review-like {
  font-size: 24rpx;
  color: #8a918d;
  padding: 4rpx 0;
}

/* ---------- 统计 ---------- */
.stat-num {
  font-size: 44rpx;
  font-weight: 600;
  color: #1b1f1d;
  font-variant-numeric: tabular-nums;
  line-height: 1.3;
}
.stat-label {
  font-size: 22rpx;
  color: #8a918d;
  margin-top: 4rpx;
}
