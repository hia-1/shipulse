/* 我的页：个人信息 / 书架 / 徽章 / 会员 / 设置 */
.avatar-lg {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f0f1f0;
  flex-shrink: 0;
}
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef1ef;
  color: #2c4a42;
  font-size: 36rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
}
.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.badge-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.badge {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}
.badge-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #f2f3f2;
}
.badge-icon-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #5a625e;
  overflow: hidden;
  padding: 0 6rpx;
  box-sizing: border-box;
  text-align: center;
}
.setting-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f3f2;
  font-size: 28rpx;
}
.setting-item:last-of-type {
  border-bottom: none;
}
