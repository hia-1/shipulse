<view class="page">
  <!-- 未登录 -->
  <view class="card empty" wx:if="{{needLogin}}">
    <view class="title-sm">登录后开始阅读计时</view>
    <view class="text-muted text-sm" style="margin-top: 8rpx">
      计时数据与 Web 端同账号同步
    </view>
    <button class="btn btn-primary btn-block" style="margin-top: 24rpx" bindtap="goLogin">
      去登录
    </button>
  </view>

  <block wx:else>
    <!-- 书籍头 -->
    <view class="card row" wx:if="{{bookTitle}}">
      <image
        wx:if="{{coverUrl && !coverFailed}}"
        class="cover-sm"
        src="{{coverUrl}}"
        mode="aspectFill"
        binderror="onCoverError"
      ></image>
      <view class="flex-1" style="margin-left: {{coverUrl && !coverFailed ? '20rpx' : '0'}}">
        <view class="title-sm">{{bookTitle}}</view>
        <view class="text-muted text-xs" style="margin-top: 6rpx">
          {{status === 'running' ? '计时中' : (status === 'finished' ? '本次已完成' : '准备开始')}}
        </view>
      </view>
    </view>

    <!-- 计时器 -->
    <view class="card timer-card">
      <view class="timer-num tabular">{{elapsedText}}</view>
      <view class="text-muted text-xs">已累计 {{durationText}}</view>
      <view class="timer-hint" wx:if="{{resumed}}">已恢复上次未结束的计时</view>
    </view>

    <!-- 待开始：起始页 + 开始计时 -->
    <view class="card" wx:if="{{status === 'idle'}}">
      <view class="row-between">
        <view class="title-sm">起始页码</view>
        <input
          class="page-input"
          type="number"
          placeholder="0"
          value="{{startPage}}"
          bindinput="onStartPageInput"
        />
      </view>
      <button
        class="btn btn-primary btn-block"
        style="margin-top: 24rpx"
        bindtap="onStart"
        disabled="{{starting}}"
      >
        开始计时
      </button>
    </view>

    <!-- 计时中：结束表单 -->
    <view class="card" wx:elif="{{status === 'running'}}">
      <view class="row-between">
        <view class="title-sm">结束页码</view>
        <input
          class="page-input"
          type="number"
          placeholder="如 42"
          value="{{endPage}}"
          bindinput="onEndPageInput"
        />
      </view>
      <view class="title-sm" style="margin-top: 24rpx">笔记摘抄</view>
      <textarea
        class="note-input"
        placeholder="记下此刻的想法（选填）"
        value="{{note}}"
        bindinput="onNoteInput"
        maxlength="1000"
        auto-height
      ></textarea>
      <button
        class="btn btn-primary btn-block"
        style="margin-top: 24rpx"
        bindtap="onFinish"
        disabled="{{finishing}}"
      >
        结束并记录
      </button>
    </view>

    <!-- 已完成 -->
    <view class="card" wx:elif="{{status === 'finished'}}">
      <view class="title-sm text-pine">本次阅读已记录</view>
      <view class="row-between" style="margin-top: 20rpx">
        <view class="stat">
          <view class="stat-num">{{durationText}}</view>
          <view class="stat-label">时长</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{endPage || '-'}}</view>
          <view class="stat-label">结束页</view>
        </view>
      </view>
      <button class="btn btn-ghost btn-block" style="margin-top: 24rpx" bindtap="goPulse">
        查看时脉
      </button>
      <button class="btn btn-primary btn-block" style="margin-top: 16rpx" bindtap="onRestart">
        再来一次
      </button>
    </view>

    <view class="card empty" wx:if="{{error}}">{{error}}</view>
  </block>
</view>
