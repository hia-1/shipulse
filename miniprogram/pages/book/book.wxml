<view class="page">
  <view class="card empty" wx:if="{{loading}}">加载中…</view>
  <view class="card empty" wx:elif="{{error}}">
    <view>{{error}}</view>
    <view class="empty-action" bindtap="onRetry">重试</view>
  </view>

  <block wx:elif="{{book}}">
    <!-- 书籍头部 -->
    <view class="card">
      <view class="row">
        <image
          wx:if="{{!coverFailed}}"
          class="cover-lg"
          src="{{book.coverUrl}}"
          mode="aspectFill"
          binderror="onCoverError"
        ></image>
        <view wx:else class="cover-lg cover-fallback">{{book.title}}</view>
        <view class="book-info" style="margin-left: 24rpx">
          <view class="title-md serif">{{book.title}}</view>
          <view class="text-secondary text-sm" style="margin-top: 8rpx">
            {{book.author}}
          </view>
          <view class="text-muted text-xs" style="margin-top: 8rpx">
            {{book.publisher}}<text wx:if="{{book.publishedDate}}"> · {{book.publishedDate}}</text>
          </view>
          <view class="row" style="margin-top: 16rpx">
            <view class="tag">{{book.categoryName || '未分类'}}</view>
            <view class="text-gold text-sm" style="margin-left: 16rpx">
              {{ratingText}} 分
            </view>
          </view>
        </view>
      </view>

      <view class="divider"></view>

      <view class="row-between">
        <view class="stat">
          <view class="stat-num">{{book.ratingCount}}</view>
          <view class="stat-label">评分人数</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{book.reviewCount}}</view>
          <view class="stat-label">书评</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{book.shelfCount}}</view>
          <view class="stat-label">加入书架</view>
        </view>
        <view class="stat">
          <view class="stat-num">{{book.pages || '-'}}</view>
          <view class="stat-label">页数</view>
        </view>
      </view>
    </view>

    <!-- 书架三态 -->
    <view class="card">
      <view class="row-between">
        <view class="title-sm">加入书架</view>
        <view class="text-muted text-xs" wx:if="{{shelfLabel}}">
          当前：{{shelfLabel}}（再次点击可移出）
        </view>
      </view>
      <view class="shelf-row">
        <view
          wx:for="{{shelfOptions}}"
          wx:key="value"
          class="chip shelf-chip {{shelfStatus === item.value ? 'chip-active' : ''}}"
          data-status="{{item.value}}"
          bindtap="onSetShelf"
        >
          {{item.label}}
        </view>
      </view>
      <button class="btn btn-primary btn-block" style="margin-top: 24rpx" bindtap="onStartReading">
        开始阅读计时
      </button>
      <button class="btn btn-ghost btn-block" style="margin-top: 16rpx" open-type="share">
        分享给好友
      </button>
    </view>

    <!-- 简介 -->
    <view class="card" wx:if="{{book.description}}">
      <view class="title-sm">内容简介</view>
      <view class="desc text-secondary text-sm" style="margin-top: 16rpx">
        {{book.description}}
      </view>
    </view>

    <!-- 标签 -->
    <view class="card" wx:if="{{book.tags.length}}">
      <view class="title-sm">标签</view>
      <view class="hot-wrap">
        <view wx:for="{{book.tags}}" wx:key="id" class="chip">{{item.name}}</view>
      </view>
    </view>

    <!-- 书评 -->
    <view class="card">
      <view class="row-between">
        <view class="title-sm">
          书评<text class="text-muted text-xs" style="margin-left: 8rpx">共 {{reviewTotal}} 条</text>
        </view>
        <view class="text-pine text-sm" bindtap="goWriteReview">写书评 ›</view>
      </view>

      <view class="empty text-muted text-sm" wx:if="{{reviewLoading}}">加载中…</view>
      <view class="empty text-muted text-sm" wx:elif="{{reviewError}}">
        <view>{{reviewError}}</view>
        <view class="empty-action" bindtap="loadReviews">重试</view>
      </view>
      <block wx:elif="{{reviews.length}}">
        <view class="review-item" wx:for="{{reviews}}" wx:key="id">
          <view class="review-head">
            <image
              wx:if="{{item.avatarUrl}}"
              class="review-avatar"
              src="{{item.avatarUrl}}"
              mode="aspectFill"
            ></image>
            <view wx:else class="review-avatar review-avatar-fallback">{{item.avatarText}}</view>
            <view class="flex-1">
              <view class="text-sm">{{item.authorName}}</view>
              <view class="text-faint text-xs">{{item.timeText}}</view>
            </view>
            <view class="text-gold text-xs">{{item.ratingText}} 分</view>
          </view>
          <view class="review-title">{{item.title}}</view>
          <view class="review-content text-secondary text-sm" wx:if="{{item.content}}">
            {{item.content}}
          </view>
          <view class="review-foot">
            <view
              class="review-like {{item.isLiked ? 'text-pine' : ''}}"
              data-id="{{item.id}}"
              data-index="{{index}}"
              bindtap="onLikeReview"
            >
              {{item.isLiked ? '已赞' : '赞'}} · {{item.likeCount}}
            </view>
            <view class="text-faint text-xs">评论 {{item.commentCount}}</view>
          </view>
        </view>
        <view class="text-muted text-xs" style="text-align: center; margin-top: 20rpx" bindtap="goWriteReview">
          查看全部 {{reviewTotal}} 条书评 ›
        </view>
      </block>
      <view class="empty text-muted text-sm" wx:else>还没有书评，去 Web 站写下第一条</view>
    </view>

    <!-- 去 Web 站引导 -->
    <view class="card web-guide">
      <view class="title-sm text-pine">在 Web 站阅读完整内容</view>
      <view class="text-muted text-sm" style="margin-top: 8rpx">
        小程序为轻量入口；书评、书单、时脉报告与阅读计时等完整功能请在 Web 站体验
      </view>
      <button class="btn btn-ghost btn-block" style="margin-top: 24rpx" bindtap="onGoWeb">
        复制链接，去 Web 站
      </button>
      <view class="text-faint text-xs" style="margin-top: 12rpx; text-align: center">
        {{webUrl}}
      </view>
    </view>
  </block>
</view>
