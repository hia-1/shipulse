.stat {
  text-align: center;
  flex: 1;
}

/* ---------- 本周柱状 ---------- */
.week-row {
  display: flex;
  align-items: flex-end;
  margin-top: 28rpx;
}
.week-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.week-bar-wrap {
  height: 140rpx;
  width: 12rpx;
  display: flex;
  align-items: flex-end;
  background: #f0f2f0;
  border-radius: 999rpx;
  overflow: hidden;
}
.week-bar {
  width: 100%;
  border-radius: 999rpx;
  transition: height 0.2s ease;
}
.week-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a918d;
}
.week-label-today {
  color: #2c4a42;
  font-weight: 600;
}

/* ---------- 打卡日历 ---------- */
.cal-nav {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  color: #5a625e;
  font-size: 32rpx;
  background: #f2f3f2;
}
.cal-head {
  display: flex;
  margin-top: 24rpx;
}
.cal-head-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #b9bfbb;
}
.cal-row {
  display: flex;
  margin-top: 8rpx;
}
.cal-cell {
  flex: 1;
  display: flex;
  justify-content: center;
  padding: 5rpx 0;
}
.cal-day {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #5a625e;
  background: transparent;
}
.cal-out {
  color: #d6dad7;
  background: transparent;
}
.cal-today {
  color: #2c4a42;
  font-weight: 600;
  background: #e7eeea;
}

/* ---------- 热力等级 ---------- */
.level-0 {
  background: transparent;
  color: #c3c8c4;
}
.level-1 {
  background: #e7eeea;
  color: #5a625e;
}
.level-2 {
  background: #c9dbd2;
  color: #2c4a42;
}
.level-3 {
  background: #7fa093;
  color: #ffffff;
}
.level-4 {
  background: #2c4a42;
  color: #ffffff;
}

/* ---------- 分享卡片 ---------- */
.share-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 12rpx;
  background: #2c4a42;
  color: #ffffff;
}
.share-title {
  font-size: 34rpx;
  font-weight: 500;
}
.share-sub {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.65);
}
.share-stats {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}
.share-stat {
  width: 50%;
  margin-bottom: 20rpx;
}
.share-stat-val {
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
}
.share-stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 2rpx;
}
.share-footer {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ---------- 订阅项 ---------- */
.sub-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f3f2;
}
.sub-item:last-of-type {
  border-bottom: none;
}
