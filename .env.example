# =========================================================
# 时脉书社-阅读世界 · 环境变量模板
# 复制本文件为 .env.dev / .env.test / .env.prod 后按环境填写
# 禁止提交真实密钥；占位值以 change_me 标识
# =========================================================

# 运行环境：dev / test / prod
NODE_ENV=dev

# 后端服务端口
APP_PORT=3000

# ---------- MySQL 8.0 ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shipulse
DB_PASSWORD=change_me
DB_NAME=shipulse
# docker-compose 初始化 root 密码（仅容器首次创建时生效）
DB_ROOT_PASSWORD=change_me_root

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---------- JWT（AccessToken + RefreshToken） ----------
JWT_SECRET=change_me
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

# ---------- 微信小程序（登录 / 手机号 / 订阅消息） ----------
# 微信公众平台「开发管理-开发设置」获取；生产必须配置，否则 /auth/wechat 拒绝服务
WECHAT_APPID=
WECHAT_SECRET=
# 强制启用 mock 适配器（仅联调/测试用；dev 环境且未配置 APPID 时自动启用）
# 生产环境切勿设置为 true
WECHAT_MOCK=

# ---------- 限流（全局限流阈值，可按环境调整） ----------
# 默认 100 次/分钟/IP；压测或高并发场景可临时调高
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---------- 反向代理 ----------
# 生产置于 nginx 之后，设为信任的代理跳数（默认 prod 自动取 1）；'false' 关闭
TRUST_PROXY=

# ---------- 运维：备份与告警（P2-16） ----------
# 备份目录与保留天数（备份脚本 backup-db.sh 使用）
BACKUP_DIR=/var/backups/shipulse
RETENTION_DAYS=7
# 企业微信群机器人 webhook（告警脚本 alert.sh 使用）
ALERT_WEBHOOK=
# 告警邮件接收地址（可选）
ALERT_EMAIL=
# 备份异地同步命令（可选，如 ossutil cp 到对象存储）
OSS_SYNC_CMD=

# ---------- Nginx 对外端口（docker-compose） ----------
NGINX_HTTP_PORT=8080
NGINX_ADMIN_PORT=8081
