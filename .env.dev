# 开发环境（本机直跑：后端连本机 MySQL/Redis；docker compose 时由 compose 覆盖 host）
NODE_ENV=dev
APP_PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shipulse
DB_PASSWORD=change_me
DB_NAME=shipulse
DB_ROOT_PASSWORD=change_me_root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=change_me
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=30d

# 微信小程序：dev 未配置 APPID 时自动走 mock 适配器（无需真实凭证即可联调）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=

NGINX_HTTP_PORT=8080
NGINX_ADMIN_PORT=8081
